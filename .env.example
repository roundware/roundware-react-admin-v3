REACT_APP_SERVER_URL=http://localhost:8000

# Which resource tabs to show in the admin
# Options: assets,audiotracks,envelopes,events,listenevents,sessions,speakers,uigroups,uiitems,tags,tag_categories,languages,localizedstrings,users
# Use "all" for everything, "none" for dashboard only
REACT_APP_INCLUDE_TABS=assets,uigroups,uiitems,tags,speakers,audiotracks

# Filter to specific project IDs (comma-separated) or "all"
REACT_APP_INCLUDE_PROJECT_IDS=all

# Google Maps API key for map views
REACT_APP_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
